# Port the server listens on
PORT=8787

# SQLite database file path
DB_PATH=./unfold.db

# Secret used to sign worker JWTs. CHANGE THIS in any real deployment.
JWT_SECRET=change-me-in-production

# Moonshot AI key for server-side GenAI features (kimi-k3).
# NEVER expose this to the Expo client or worker-web. Optional:
# when unset, every GenAI feature uses its deterministic local fallback
# and marks results with genai=0 so UIs can show they are not GenAI.
MOONSHOT_API_KEY=

# Moonshot OpenAI-compatible base URL
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Model used for all GenAI features
GENAI_MODEL=kimi-k3

# Hours a case may sit in queued/rematch unclaimed before the student
# is shown a "still waiting" flag (read-time flag, not a status change)
UNCLAIMED_TIMEOUT_HOURS=72

# Hours a worker may hold a claimed case without responding before the
# case auto-returns to the queue as status "rematch"
RESPONSE_TIMEOUT_HOURS=48
